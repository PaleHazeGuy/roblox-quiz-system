# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Bangkok

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=roblox_dashboard
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/roblox_dashboard

# Dashboard user auth
USER_JWT_SECRET=change_me_long_random_string
USER_JWT_EXPIRES_IN=1d

# Roblox auth
ROBLOX_API_SECRET=change_me_long_random_string
ROBLOX_JWT_SECRET=change_me_long_random_string
ROBLOX_JWT_TTL_SECONDS=600
ALLOWED_PLACE_IDS=0

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
